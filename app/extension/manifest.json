{
  "action": {
    "default_popup": "popup.html",
    "default_title": "フリマコピー（自作）"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "lib/store.js",
        "readers/mercari.js"
      ],
      "matches": [
        "https://jp.mercari.com/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "readers/todos.js"
      ],
      "matches": [
        "https://jp.mercari.com/todos",
        "https://jp.mercari.com/transaction/*",
        "https://jp.mercari.com/transactions/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "lib/store.js",
        "readers/rakuma.js"
      ],
      "matches": [
        "https://item.fril.jp/*",
        "https://fril.jp/item/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "lib/store.js",
        "readers/paypay.js"
      ],
      "matches": [
        "https://paypayfleamarket.yahoo.co.jp/*",
        "https://paypayfleamarket-sec.yahoo.co.jp/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "lib/store.js",
        "readers/yahoo.js"
      ],
      "matches": [
        "https://auctions.yahoo.co.jp/jp/auction/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "readers/yahoo-closed-relist.js"
      ],
      "matches": [
        "https://auctions.yahoo.co.jp/my/closed*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "readers/yahoo-sold.js"
      ],
      "matches": [
        "https://auctions.yahoo.co.jp/my/closed*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "lib/store.js",
        "lib/fill.js",
        "fillers/sell-mercari.js"
      ],
      "matches": [
        "https://jp.mercari.com/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "lib/store.js",
        "lib/fill.js",
        "fillers/sell-rakuma.js"
      ],
      "matches": [
        "https://fril.jp/item/new*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "lib/store.js",
        "lib/fill.js",
        "fillers/sell-paypay.js"
      ],
      "matches": [
        "https://paypayfleamarket.yahoo.co.jp/*",
        "https://paypayfleamarket-sec.yahoo.co.jp/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "lib/store.js",
        "lib/fill.js",
        "fillers/sell-yahoo.js"
      ],
      "matches": [
        "https://auctions.yahoo.co.jp/jp/show/*",
        "https://auctions.yahoo.co.jp/sell/*"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "description": "フリマサイトの商品ページから出品情報を読み取り、別サイトの出品フォームへ自動入力する自作拡張機能。",
  "host_permissions": [
    "https://jp.mercari.com/*",
    "https://static.mercdn.net/*",
    "https://fril.jp/*",
    "https://item.fril.jp/*",
    "https://img.fril.jp/*",
    "https://paypayfleamarket.yahoo.co.jp/*",
    "https://paypayfleamarket-sec.yahoo.co.jp/*",
    "https://auctions.yahoo.co.jp/*",
    "https://*.yimg.jp/*",
    "https://gist.githubusercontent.com/*",
    "https://api.github.com/*",
    "http://127.0.0.1/*"
  ],
  "manifest_version": 3,
  "name": "フリマコピー（自作）",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting"
  ],
  "version": "0.12.31"
}